<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Make Fruit Yogurt a social drug so it appears in drug policies and can be
	     scheduled/limited there instead of being eaten as ordinary food. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="FruitYogurt"]/ingestible</xpath>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="FruitYogurt"]/ingestible</xpath>
					<value>
						<drugCategory>Social</drugCategory>
					</value>
				</li>
				<!-- Like Chocolate/Caramel: never eaten for hunger, only via drug policy / joy -->
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="FruitYogurt"]/ingestible/preferability</xpath>
					<value>
						<preferability>DesperateOnly</preferability>
					</value>
				</li>
				<!-- Vanilla sorts drug policy entries by CompProperties_Drug.listOrder,
				     so every drug MUST have the comp or policy creation NREs. -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="FruitYogurt"]/comps</xpath>
					<value>
						<li Class="CompProperties_Drug">
							<addictiveness>0</addictiveness>
							<listOrder>1100</listOrder>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
